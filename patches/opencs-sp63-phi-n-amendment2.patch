@@ -0,0 +1,42 @@
+using CScore.Sp63Shear;
+using Xunit;
+
+namespace CScore.Tests.Sp63Shear;
+
+public class PhiNAmendment2Tests
+{
+    // Independent values from SP63.13330.2018 amendment 2, 8.1.34.
+    [Theory]
+    [InlineData(0, 1)]
+    [InlineData(-100, 1.1)]
+    [InlineData(-250, 1.25)]
+    [InlineData(-250.001, 1.25)]
+    [InlineData(-500, 1.25)]
+    [InlineData(-500.001, 1.2499975)]
+    [InlineData(-750, .625)]
+    [InlineData(-900, .25)]
+    [InlineData(-1000, 0)]
+    [InlineData(-1100, 0)]
+    [InlineData(50, .75)]
+    [InlineData(100, .5)]
+    [InlineData(200, 0)]
+    [InlineData(300, 0)]
+    public void CoefficientMatchesNormativeBranches(double n, double expected)
+    {
+        var g = new InclinedSectionGeometry(1,1,0,0,1000,100,1,0,
+            30000000,.002,.0001,ShearPlane.Vy,true,[]);
+        var actual = PhiNCalculator.Compute(ElementKind.Other,n,g);
+        Assert.Equal(expected, actual.Value, 10);
+        Assert.Equal(n<0,actual.AppliesToStrip);
+    }
+
+    [Theory]
+    [InlineData(.4)]
+    [InlineData(1.25)]
+    public void SimplifiedStirrupTermDoesNotReceiveConcretePhiN(double phi)
+    {
+        var input = new ShearInclinedInput(.3,.55,14500,1050,200,.15,435,
+            ElementKind.Other,1,0,0,0,[],false,null);
+        Assert.Equal(55,ShearFormulas.MinStirrupShear(input,.275,out _,200,phi),10);
+    }
+}
