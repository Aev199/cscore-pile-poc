<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>CScorePileRunner</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../vendor/OpenCS/CScore/CScore.csproj" />
  </ItemGroup>
  <Target Name="ApplyPinnedCScoreCorrections" BeforeTargets="ResolveProjectReferences">
    <Exec Command="python &quot;$(MSBuildThisFileDirectory)../../tools/apply_opencs_patches.py&quot;" />
  </Target>
</Project>
